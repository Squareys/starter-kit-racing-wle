{
    "settings": {
        "project": {
            "name": "starter-kit-racing",
            "version": [
                1,
                6,
                1
            ],
            "description": "Arcade racing on a tile-based track with a track editor, built with Wonderland Engine."
        },
        "scripting": {
            "components": {
                "output": "Project-bundle.js"
            },
            "application": {
                "output": "Project-app.js"
            }
        },
        "editor": {
            "serverPort": 8082,
            "importPhysicalAsPhongMaterials": false
        },
        "xr": {
            "vr": {
                "enable": false
            }
        },
        "rendering": {
            "sky": {
                "enabled": true,
                "material": "15"
            },
            "environment": {
                "enabled": true,
                "bakingMode": "sky",
                "material": "15"
            },
            "hdr": {
                "tonemapping": "aces"
            },
            "bloom": {
                "enabled": true,
                "threshold": 1.5,
                "intensity": 0.6
            },
            "ssao": {
                "enabled": true,
                "radius": 0.6,
                "intensity": 1.0
            }
        }
    },
